# The DESIGN lane of nulltrader: `systemctl enable --now watcher@nulltrader-design` (the
# deployer starts it on its own when this file ships). Everything but the name and the
# lane comes from nulltrader.env, so the board, the repo and the list of design agents are
# defined in exactly one place.
. "$(dirname "${BASH_SOURCE[0]}")/nulltrader.env"
PROJECT_NAME=nulltrader-design
LANE_AGENTS="${DESIGN_AGENTS}"
