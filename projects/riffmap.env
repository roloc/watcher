# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@<PROJECT_NAME>`), because deploy/rollout.sh and
# the state directory are both keyed on it.
PROJECT_NAME=riffmap
PROJECT_ROOT=/home/watcher/projects/riffmap
BOARD_OWNER=roloc
PROJECT_REPO=roloc/riffmap
BOARD_NUMBER=1
# Discord: the box-wide DISCORD_WEBHOOK_URL in /etc/watcher/env applies to every project.
# Set one here only if this project wants its own channel (never commit the URL).

# Lanes. riffmap runs as three instances side by side: this one, the BUILD lane,
# watcher@riffmap-design (projects/riffmap-design.env) and watcher@riffmap-triage
# (projects/riffmap-triage.env), both of which source this file. The design lane takes
# the cards whose `agent:` label is in DESIGN_AGENTS; the triage lane takes the cards
# with no agent label (`-`) and only labels them; this lane takes every other card. One
# list, defined once, and `-` excluded here, so the three lanes are complements by
# construction and can never want the same card.
DESIGN_AGENTS=architect,designer
LANE_AGENTS="!${DESIGN_AGENTS},-"

# Self-pull (September 19, 2026). All three lanes inherit this, because they source this
# file. When In progress and Waiting are both dry, a lane promotes the top Ready card
# (P0 first) to In progress and works it, so a card no longer waits on Steve's hand to
# start. WIP_MAX is board-wide and counts the whole In progress column: at 2, the loop
# keeps two cards moving and leaves the rest of Ready alone.
READY_PULL=1
WIP_MAX=2

# The per-tick quota cap (--max-budget-usd; spawn.sh's default is 15). Raised to 100 on
# September 21, 2026 at Steve's call: the subscription has room, and quota spent on real
# work is fine — only waste is not. riffmap#458 died at $15 after 44 productive minutes (a
# trim back end, ~20 files staged), almost all of it subagent context. What stops a tick
# that is looping is the watchdog (TICK_TIMEOUT, 150 min) and --max-turns (400); this is a
# backstop behind them, not the limit. The triage lane keeps its own 2 (it only labels).
TICK_MAX_BUDGET_USD=100

# The tick itself runs on the box's Claude subscription (CLAUDE_CODE_OAUTH_TOKEN in
# /etc/watcher/env), so --max-budget-usd is a quota meter, not a bill. The project's own
# pipeline is the other dollar, and it is NOT pinned anywhere on this box: bin/worktree.sh
# symlinks riffmap's .env.local — which holds ANTHROPIC_API_KEY — into every card worktree,
# and riffmap's code default is still RIFFMAP_BACKEND=api (Main.kt, four `?: "api"` sites).
# A tick that ran `riffmap detect` or `extract` would therefore take the API path, guarded
# only by a sentence in watch.md asking the agent to escalate over ~$2.
#
# `claude` is the same posture the deployed box already runs: deploy/riffmap-run.service
# and deploy/riffmap-rebuild.service both pin RIFFMAP_BACKEND=claude, and /etc/riffmap/env
# leaves it unset. Pinning it here makes a card worktree match the units — the subscription,
# never the API — by construction instead of by instruction, and unlike `replay` it leaves a
# tick able to run the pipeline on a transcript that has no cassette.
#
# This is a stopgap for the box, not the fix. The fix is riffmap's own default, which is
# riffmap card https://github.com/roloc/riffmap/issues/424 is for; when that lands this
# line is redundant and goes.
export RIFFMAP_BACKEND=claude
