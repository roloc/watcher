# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@<PROJECT_NAME>`), because deploy/rollout.sh and
# the state directory are both keyed on it.
PROJECT_NAME=riffmap
PROJECT_ROOT=/home/watcher/projects/riffmap
BOARD_OWNER=roloc
PROJECT_REPO=roloc/riffmap
BOARD_NUMBER=1
# Discord: the box-wide DISCORD_WEBHOOK_URL in /etc/watcher/env applies to every project.
# Set one here only if this project wants its own channel (never commit the URL).

# Lanes. riffmap runs as three instances side by side: this one, the BUILD lane,
# watcher@riffmap-design (projects/riffmap-design.env) and watcher@riffmap-triage
# (projects/riffmap-triage.env), both of which source this file. The design lane takes
# the cards whose `agent:` label is in DESIGN_AGENTS; the triage lane takes the cards
# with no agent label (`-`) and only labels them; this lane takes every other card. One
# list, defined once, and `-` excluded here, so the three lanes are complements by
# construction and can never want the same card.
DESIGN_AGENTS=architect,designer
LANE_AGENTS="!${DESIGN_AGENTS},-"
