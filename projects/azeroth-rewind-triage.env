# The TRIAGE lane of azeroth-rewind: `systemctl enable --now watcher@azeroth-rewind-triage`.
# Exactly the cards with NO `agent:` label; /triage reads the card, adds the one label,
# records what it waits on, and stops. Same caps as riffmap's triage lane.
. "$(dirname "${BASH_SOURCE[0]}")/azeroth-rewind.env"
PROJECT_NAME=azeroth-rewind-triage
LANE_AGENTS="-"
LANE_COMMAND=/triage
LANE_WORKDIR=root
TICK_MAX_TURNS=40
TICK_MAX_BUDGET_USD=2
TICK_TIMEOUT=15
