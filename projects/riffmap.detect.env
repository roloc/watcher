# Sourced by bin/detect.sh after projects/riffmap.env (card #36: "nothing watches the
# product, so a regression on staging waits for Steve to notice it"). Inert until someone
# runs `systemctl enable --now watcher-detect@riffmap` on the box — dropping this file in
# does not start anything.
#
# Metric: one probe of lonestar-web a run (projects/riffmap-health-probe.sh), 1 on a
# failed or non-2xx/3xx response, 0 on a healthy one. bin/detect.sh turns a run of these
# into a rolling failure rate over DETECT_BASELINE_WINDOW readings and compares that to
# the fixed bands below — a single bad probe is not a breach, a sustained run of them is.
DETECT_WHAT="lonestar-web's health probes failing"
DETECT_METRIC_CMD="projects/riffmap-health-probe.sh"
DETECT_LOOK_URL="http://192.168.176.37/"

# The timer (deploy/watcher-detect@.timer) runs every 15 minutes, so 12 readings is a
# 3-hour window; 4 readings (an hour) before a breach can be tiered at all.
DETECT_BASELINE_WINDOW=12
DETECT_MIN_READINGS=4

# Fixed bands on the rolling failure rate, not on any one reading: >=1 bad probe in the
# last 3 (1/3 = 0.34) logs it; >=2 of the last 3 (0.67) files a card.
DETECT_SMALL_BAND=0.34
DETECT_LARGE_BAND=0.67
