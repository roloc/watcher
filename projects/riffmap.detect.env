# Sourced by bin/detect.sh after projects/riffmap.env (card #36: "nothing watches the
# product, so a regression on staging waits for Steve to notice it"). Merging this file is
# what turns detection on: `deploy/install.sh` enables `watcher-detect@riffmap.timer` for
# every `projects/<name>.detect.env` it finds, and reruns on every deploy.
#
# Metric: one probe of RiffMap itself a run (projects/riffmap-health-probe.sh), pinned to
# lonestar-web's LAN address but sent by RiffMap's own hostname so the box's default vhost
# never answers in its place (roloc/watcher#36, Steve, September 28, 2026) — 1 on anything
# but a 200 or 401 response (the app's own answer to an anonymous /api/me), 0 on a healthy
# one. bin/detect.sh turns a run of these into a rolling failure rate over
# DETECT_BASELINE_WINDOW readings and compares that to the fixed bands below — a single bad
# probe is not a breach, a sustained run of them is.
DETECT_WHAT="RiffMap's health probes failing"
DETECT_METRIC_CMD="projects/riffmap-health-probe.sh"
DETECT_LOOK_URL="https://riffmap.lonestarprod.com/"

# The timer (deploy/watcher-detect@.timer) runs every 15 minutes, so 12 readings is a
# 3-hour window; 4 readings (an hour) before a breach can be tiered at all.
DETECT_BASELINE_WINDOW=12
DETECT_MIN_READINGS=4

# Fixed bands on the rolling failure rate (the share of the last DETECT_BASELINE_WINDOW
# readings — fewer while still warming up — that failed), not on any one reading: about a
# third failing logs it, about two-thirds files a card.
DETECT_SMALL_BAND=0.34
DETECT_LARGE_BAND=0.67
