# The TRIAGE lane of riffmap: `systemctl enable --now watcher@riffmap-triage`. It takes
# exactly the cards with NO `agent:` label, runs `/triage` on each (commands/triage.md:
# read the card, add the one label, record what it waits on, stop) in the project's main
# checkout with no worktree, and never does the work itself. The build lane excludes
# unlabeled cards (riffmap.env), so the three lanes stay complements by construction.
. "$(dirname "${BASH_SOURCE[0]}")/riffmap.env"
PROJECT_NAME=riffmap-triage
LANE_AGENTS="-"
LANE_COMMAND=/triage
LANE_WORKDIR=root
# A triage is a few board calls; cap it well below a working tick.
TICK_MAX_TURNS=40
TICK_MAX_BUDGET_USD=2
TICK_TIMEOUT=15
