# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@<PROJECT_NAME>`). riffmap-site is the marketing
# website for riffmap (https://github.com/roloc/riffmap-site), its own repo and board
# since October 8, 2026 — a static site with no model calls of its own.
PROJECT_NAME=riffmap-site
PROJECT_ROOT=/home/watcher/projects/riffmap-site
BOARD_OWNER=roloc
PROJECT_REPO=roloc/riffmap-site
BOARD_NUMBER=3
WORKTREE_COPY_DIRS=""

# Lanes, the riffmap shape: this is the BUILD lane; watcher@riffmap-site-design takes the
# cards whose `agent:` label is in DESIGN_AGENTS — on this project that is most of the
# early work (the positioning brief, the brand directions, every page's mockup); the
# triage lane takes the unlabeled cards and only labels them. One list, `-` named once,
# so the three lanes are complements by construction.
DESIGN_AGENTS=architect,researcher,brand,designer
LANE_AGENTS="!${DESIGN_AGENTS},-"

READY_PULL=1
WIP_MAX=2
TICK_MAX_BUDGET_USD=100
