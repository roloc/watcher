# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@twreborn`). Trade Wars Reborn is the Godot 4
# prototype of a TradeWars 2002 revival (https://github.com/roloc/twreborn): single
# player, a sector map, and draining port pairs. docs/prototype-plan.md in that repo is
# the milestone plan its cards were drafted from; on the watcher since October 26, 2026.
PROJECT_NAME=twreborn
PROJECT_ROOT=/home/watcher/projects/twreborn
BOARD_OWNER=roloc
PROJECT_REPO=roloc/twreborn
BOARD_NUMBER=7
# No gitignored in-tree private inputs: everything a card needs is committed (docs,
# ruleset, tests) or attached to the card itself (a playtest CSV, a screenshot).
WORKTREE_COPY_DIRS=""

# One lane, no LANE_AGENTS, so it takes every card on the board, labeled or not — the
# watcher's own board's shape, not riffmap's: a solo prototype needs no design or triage
# lane. The milestone cards carry blocked-by relationships, so the spawner works them in
# order however many sit in Ready at once.
#
# Self-pull: Steve moves a card to Ready and the lane starts it the next time nothing is
# in flight. WIP_MAX=1 because the milestones are a chain in one codebase: two cards
# moving at once would conflict in the same files, not go faster.
READY_PULL=1
WIP_MAX=1

# The quota backstop, at riffmap's figure (September 21, 2026: quota spent on real work
# is fine, only waste is not). The watchdog (TICK_TIMEOUT) and --max-turns are what stop
# a looping tick; this is a backstop behind them, not the limit.
TICK_MAX_BUDGET_USD=100

# The game calls no model and has no API key of its own, so a tick here spends
# subscription quota only — there is no real bill behind it.
