# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@twreborn`). Trade Wars Reborn is the Godot 4
# prototype of a TradeWars 2002 revival (https://github.com/roloc/twreborn): single
# player, a sector map, and draining port pairs. docs/prototype-plan.md in that repo is
# the milestone plan its cards were drafted from; on the watcher since October 26, 2026.
PROJECT_NAME=twreborn
PROJECT_ROOT=/home/watcher/projects/twreborn
BOARD_OWNER=roloc
PROJECT_REPO=roloc/twreborn
BOARD_NUMBER=7
# No gitignored in-tree private inputs: everything a card needs is committed (docs,
# ruleset, tests) or attached to the card itself (a playtest CSV, a screenshot).
WORKTREE_COPY_DIRS=""

# Lanes, three of them, riffmap's shape (October 26, 2026 — the owner wants design and
# triage visible on the floor from the start, and a game-designer role in the mix): this
# is the BUILD lane; watcher@twreborn-design (projects/twreborn-design.env) takes the
# cards whose `agent:` label is in DESIGN_AGENTS — architect (system/spec judgment) and
# game-designer (mechanics, balance, fun; the twreborn repo's .claude/agents define both);
# watcher@twreborn-triage (projects/twreborn-triage.env) takes the unlabeled cards (`-`)
# and only labels them. One list, defined once, `-` excluded here, so the three lanes are
# complements by construction and can never want the same card. The game-designer shares
# the design lane rather than getting a fourth: design cards of either kind are the same
# kind of work to schedule, and WIP_MAX already caps the board.
DESIGN_AGENTS=architect,game-designer
LANE_AGENTS="!${DESIGN_AGENTS},-"

# Self-pull: Steve moves a card to Ready and a lane starts it when nothing of its kind is
# in flight. WIP_MAX counts the whole In progress column: 2 lets a design card move beside
# a build card; the milestone chain itself stays sequential through its blocked-by
# relationships, not through this cap.
READY_PULL=1
WIP_MAX=2

# The quota backstop, at riffmap's figure (September 21, 2026: quota spent on real work
# is fine, only waste is not). The watchdog (TICK_TIMEOUT) and --max-turns are what stop
# a looping tick; this is a backstop behind them, not the limit.
TICK_MAX_BUDGET_USD=100

# The game calls no model and has no API key of its own, so a tick here spends
# subscription quota only — there is no real bill behind it.
