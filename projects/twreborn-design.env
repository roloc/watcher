# The DESIGN lane of twreborn: `systemctl enable --now watcher@twreborn-design` (the
# deployer starts it on its own when this file ships). Everything but the name and the
# lane comes from twreborn.env, so the board, the repo and the list of design agents are
# defined in exactly one place.
. "$(dirname "${BASH_SOURCE[0]}")/twreborn.env"
PROJECT_NAME=twreborn-design
LANE_AGENTS="${DESIGN_AGENTS}"
