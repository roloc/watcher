# Sourced by bin/spawn.sh (WATCHER_PROJECT). One file per systemd instance; PROJECT_NAME
# must equal the instance name (`watcher@<PROJECT_NAME>`). Azeroth Rewind is a Next.js 16
# web app (https://github.com/roloc/azeroth-rewind, live at https://azerothrewind.com)
# that turns a WoW player's season into shareable cards; on the watcher since October 9,
# 2026, the day its old PR reviewer (Barf) was found to no longer exist.
PROJECT_NAME=azeroth-rewind
PROJECT_ROOT=/home/watcher/projects/azeroth-rewind
BOARD_OWNER=roloc
PROJECT_REPO=roloc/azeroth-rewind
BOARD_NUMBER=4
# No gitignored in-tree inputs: the app's data is the shared Postgres and Redis named in
# .env.local (symlinked into every card worktree by bin/worktree.sh), reachable on the LAN.
WORKTREE_COPY_DIRS=""

# Lanes, two of them: this is the BUILD lane and takes every card that carries an `agent:`
# label (architect, builder, scribe — the repo has no design agents, so one lane works
# them all); watcher@azeroth-rewind-triage (projects/azeroth-rewind-triage.env) takes the
# unlabeled cards (`-`) and only labels them. `!-` here and `-` there are complements by
# construction, so no card can ever belong to both.
LANE_AGENTS="!-"

# Self-pull, as riffmap has it: when In progress and Waiting are both dry, the lane
# promotes the top Ready card (P0 first) to In progress. WIP_MAX counts this board's whole
# In progress column.
READY_PULL=1
WIP_MAX=2

# The quota backstop, at riffmap's figure (September 21, 2026: quota spent on real work is
# fine, only waste is not). The watchdog and --max-turns are what stop a looping tick.
TICK_MAX_BUDGET_USD=100

# The app calls no model of its own, so there is no backend to pin. Its real spend is API
# points: Warcraft Logs gives 18,000 an hour, SHARED with production, and a cold recap
# compute from a card worktree draws on it — the project's CLAUDE.md ("Running under the
# watcher") tells the tick to cost a test run and ask before a wave. QUEUE_PREFIX stays
# unset in .env.local on purpose: unset derives a per-worktree namespace, so a worker
# started in a card worktree can never consume production's jobs.
