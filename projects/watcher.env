# Sourced by bin/spawn.sh (WATCHER_PROJECT). The watcher working its own board:
# `systemctl enable --now watcher@watcher`. One lane, no LANE_AGENTS, so it takes every
# card on the board, labeled or not. The repo has no design agents, so /watch's routing
# rule has nowhere to send a card and simply works it.
#
# PROJECT_ROOT is a SEPARATE checkout from /opt/watcher, on purpose. /opt/watcher is the
# code every lane on the box is running; a tick edits this checkout and opens a PR, and
# nothing it merges goes live until Steve runs deploy/rollout.sh. That hand-run rollout is
# the gate between the watcher changing itself and the watcher running the change — see
# "When the watcher works its own board" in this repo's CLAUDE.md.
PROJECT_NAME=watcher
PROJECT_ROOT=/home/watcher/projects/watcher
BOARD_OWNER=roloc
PROJECT_REPO=roloc/watcher
BOARD_NUMBER=2
# The watcher has no gitignored private inputs to copy into a card worktree.
WORKTREE_COPY_DIRS=""

# Self-pull, as riffmap has it (projects/riffmap.env): Steve moves a card to Ready, and
# the lane promotes it to In progress when nothing is in flight. WIP_MAX counts this
# board's In progress column only; riffmap's board keeps its own.
READY_PULL=1
WIP_MAX=1

# The quota backstop, at riffmap's figure (September 21, 2026: quota spent on real work is
# fine, only waste is not). The watchdog and --max-turns are what stop a looping tick.
TICK_MAX_BUDGET_USD=100
