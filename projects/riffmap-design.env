# The DESIGN lane of riffmap: `systemctl enable --now watcher@riffmap-design`. Everything
# but the name and the lane comes from riffmap.env, so the board, the repo and the list of
# design agents are defined in exactly one place.
. "$(dirname "${BASH_SOURCE[0]}")/riffmap.env"
PROJECT_NAME=riffmap-design
LANE_AGENTS="${DESIGN_AGENTS}"
