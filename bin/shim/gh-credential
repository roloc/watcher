#!/usr/bin/env bash
# A git credential helper (card #255): `git config credential.https://github.com.helper
# '!/opt/watcher/bin/shim/gh-credential'`. On `get` it prints the project's author-App
# installation token as the password, minted per call (cached an hour by bin/gh-app-token.sh).
# With no App set up it prints nothing, so git falls through to the next helper. `store` and
# `erase` do nothing: a token is never written down here.
set -u
[ "${1:-}" = get ] || exit 0
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
host=""
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  [ "$k" = host ] && host="$v"
done
[ "$host" = github.com ] || exit 0
token="$("${WATCHER_APP_TOKEN:-$here/../gh-app-token.sh}" author 2>/dev/null)" || exit 0
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
