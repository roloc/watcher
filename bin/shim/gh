#!/usr/bin/env bash
# watcher-gh-shim — the marker line spawn.sh and this file look for to tell a shim from the real gh.
# The `gh` a tick's shell (and board.py, which calls `gh`) finds first (card #255). When the
# project has GitHub Apps set up (bin/gh-app-token.sh finds its config), this exports a fresh
# author-App installation token as GH_TOKEN and execs the real gh; otherwise it execs the real
# gh untouched, so a box or fork on a single bot account's `gh auth login` is unchanged.
#
# The token is minted per invocation (cached an hour by the token script), never stored with
# `gh auth login`: a tick can outlive a 60-minute token. A `gh pr checks --watch` that outlives
# its token fails and the tick re-runs it, as commands/watch.md already says.
# WATCHER_APP_ROLE=reviewer asks for the reviewer App instead (bin/review-submit.sh only).
# A token the caller already set in GH_TOKEN is kept.
set -u
self="${BASH_SOURCE[0]}"
here="$(cd "$(dirname "$self")" && pwd)"
# Never exec another watcher shim (card #293). After a release flip a long-lived lane still
# carries the OLD release's bin/shim on its PATH, so "skip my own directory" found that
# release's shim, which found this one: two different files exec'ing each other forever, a hung
# doctor.sh on every lane (November 11-12, 2026). A file named gh in a shim/ directory, or one
# whose first bytes carry the marker above, is a shim. `read` is a builtin and takes only the
# head of the file, so a multi-megabyte real gh is never slurped.
is_shim() {
  case "$1" in */shim/gh) return 0 ;; esac
  [ -r "$1" ] || return 1
  local head=""; IFS= read -r -d '' -n 512 head < "$1" 2>/dev/null || true
  case "$head" in *watcher-gh-shim*) return 0 ;; esac
  return 1
}
# Backstop for any loop the checks above miss: each hop adds one, and a real gh that runs `gh`
# itself (an extension, an alias) is a hop or two, never eight. Loud, not a silent hang.
depth="${WATCHER_GH_SHIM_DEPTH:-0}"
case "$depth" in ''|*[!0-9]*) depth=0 ;; esac
if [ "$depth" -ge 8 ]; then
  echo "gh shim: called itself $depth times (two watcher shims finding each other?); refusing to loop" >&2
  exit 127
fi
export WATCHER_GH_SHIM_DEPTH=$((depth + 1))
real="${WATCHER_REAL_GH:-}"
case "$real" in */*) ;; *) real="" ;; esac
[ -n "$real" ] && [ "$real" -ef "$self" ] && real=""
[ -n "$real" ] && is_shim "$real" && real=""
if [ -z "$real" ]; then
  IFS=: read -r -a dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    [ -n "$d" ] && [ -x "$d/gh" ] || continue
    [ "$d/gh" -ef "$self" ] && continue
    is_shim "$d/gh" && continue
    real="$d/gh"; break
  done
fi
[ -n "$real" ] || { echo "gh shim: no real gh found on PATH" >&2; exit 127; }

if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  minter="${WATCHER_APP_TOKEN:-$here/../gh-app-token.sh}"
  role="${WATCHER_APP_ROLE:-author}"
  # On success the minter prints only the token; on failure only one line of why. "No App set
  # up" and "no project" are the fallback path (today's gh login); anything else is loud, so a
  # revoked key never quietly turns into the old machine account.
  errf="$(mktemp 2>/dev/null)" || errf=/dev/null
  if out="$("$minter" "$role" 2>"$errf")"; then
    [ -n "$out" ] && export GH_TOKEN="$out"
  else
    out="$(cat "$errf" 2>/dev/null)"
    case "$out" in
      *"no App set up"*|*"no project"*) ;;
      *) printf '%s\n' "$out" >&2; rm -f "$errf"; exit 1 ;;
    esac
  fi
  [ "$errf" = /dev/null ] || rm -f "$errf"
fi
exec "$real" "$@"
