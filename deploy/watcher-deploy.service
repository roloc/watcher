# The deployer: deploy/autodeploy.sh, one step per run. Started by watcher-deploy.timer.
# Runs as root because it restarts the watcher@ units; everything it does to git and GitHub
# it does as the watcher user (su - watcher), which holds the checkout and the gh login.
[Unit]
Description=Deploy the watcher's main when every lane is idle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/watcher/deploy/autodeploy.sh
StateDirectory=watcher-deploy
# gh as the author App, not the watcher user's login (card #273). autodeploy.sh passes these
# two through its `su -` (a login shell resets PATH), so they are named here and read there.
Environment=PATH=/opt/watcher/bin/shim:/usr/local/bin:/usr/bin:/bin
Environment=WATCHER_APP_PROJECT=watcher
# The replay suite runs live ticks (up to ~8 min a case); a run can take a while.
TimeoutStartSec=90min
