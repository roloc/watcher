# The floor page (bin/floor.py, card #40): a live, read-only view of every watcher lane on
# this box, so Steve does not need ssh or journalctl to see what is running. Always on, one
# instance per box (not a `watcher@` template — it is not a lane, it does no work and holds
# no card). deploy/install.sh restarts it on every deploy: cheap and safe, since it holds
# no work in flight and its own cache rebuilds in a few seconds.
[Unit]
Description=The floor page: a live view of every watcher lane on this box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=watcher
Group=watcher
WorkingDirectory=/opt/watcher
Environment=HOME=/home/watcher
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The floor's own secrets, and only the floor's: the Proxmox API token for the server
# room's lab readout (PROXMOX_URL, PROXMOX_TOKEN, PROXMOX_VERIFY). Never /etc/watcher/env —
# that file is every lane's environment, which is to say every tick's, a Claude process
# with no permission prompts; a token there reaches the one place it must not and never
# the one process that needs it (review of roloc/watcher#107). Optional: the readout
# says how to turn it on until the file has values. install.sh seeds it empty.
EnvironmentFile=-/etc/watcher/floor.env
ExecStart=/usr/bin/python3 /opt/watcher/bin/floor.py
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
