# One detector instance per project: `deploy/install.sh` enables
# `watcher-detect@<name>.timer` for every `projects/<name>.detect.env` it finds, and reruns
# on every deploy — merging that config file is what turns detection on (this unit carries
# no [Install] section — it is driven by the timer, not enabled itself, the same shape as
# watcher-deploy.service/.timer). Reads projects/%i.detect.env; a project with no such file
# makes bin/detect.sh exit 0 immediately, so enabling this for one that has not opted in is
# harmless but pointless. Unlike watcher@.service this is Type=oneshot — a deploy that
# updates /opt/watcher needs no restart here, the next timer firing just runs the new code.
[Unit]
Description=Regression detector for %i
After=network-online.target

[Service]
Type=oneshot
User=watcher
Group=watcher
WorkingDirectory=/opt/watcher
EnvironmentFile=/etc/watcher/env
Environment=HOME=/home/watcher
# gh through the author App like a tick (card #273): the shim first on PATH mints its token; the
# box's own project is the one whose App is installed on every organization repo.
Environment=PATH=/opt/watcher/bin/shim:/usr/local/bin:/usr/bin:/bin
Environment=WATCHER_APP_PROJECT=watcher
ExecStart=/opt/watcher/bin/detect.sh %i
